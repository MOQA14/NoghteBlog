# ---------------------------------------------------------------------------
# نمونه‌ی متغیرهای محیطی.
#
#   توسعه‌ی لوکال:  cp .env.example .env  — همین‌طور که هست کار می‌کند.
#   سرور dev/prd:   بخش دوم را ببینید؛ dokploy این مقادیر را تزریق می‌کند.
#
# تنظیمات پروژه یک فایل است (config/settings.py) و تفاوت محیط‌ها فقط از همین
# متغیرها می‌آید. کلید اصلی DEBUG است.
# ---------------------------------------------------------------------------

# =========================== توسعه‌ی لوکال ===============================
# بدون DATABASE_URL از SQLite استفاده می‌شود، پس برای شروع دیتابیس لازم نیست.

DEBUG=true
SECRET_KEY=insecure-local-development-key
WAGTAIL_SITE_NAME=بلاگ نقطه

# با DEBUG=true مقدار ALLOWED_HOSTS اگر خالی باشد خودکار ["*"] می‌شود.


# ========================== سرور dev و prd ===============================
# این‌ها را در dokploy تنظیم کنید، نه در فایل .env داخل ریپو.
#
# DEBUG=false
#
# SECRET_KEY=یک-کلید-تصادفی-بلند-و-یکتا
#   ساخت کلید:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
#
# ALLOWED_HOSTS=blog.example.com
# WAGTAILADMIN_BASE_URL=https://blog.example.com
# CSRF_TRUSTED_ORIGINS=https://blog.example.com   # اگر ندهید از ALLOWED_HOSTS ساخته می‌شود
#
# با docker-compose.yml مقدار DATABASE_URL و MEDIA_ROOT خودکار ساخته می‌شوند
# و فقط این سه تا را لازم دارید:
# POSTGRES_DB=noghteblog
# POSTGRES_USER=noghteblog
# POSTGRES_PASSWORD=یک-رمز-قوی      # openssl rand -hex 32
#
# بدون docker-compose، مستقیم:
# DATABASE_URL=postgres://user:password@db:5432/noghteblog
# MEDIA_ROOT=/app/media


# ============================== اختیاری ==================================
# WAGTAIL_ADMIN_URL=admin          # مسیر پنل مدیریت
# BLOG_API_ENABLED=true            # API فقط-خواندنی
# WAGTAIL_ALLOW_UNICODE_SLUGS=true # اسلاگ فارسی
# LANGUAGE_CODE=fa
# TIME_ZONE=Asia/Tehran
# LOG_LEVEL=INFO
#
# این‌ها با DEBUG=false خودکار روشن می‌شوند و فقط در صورت نیاز override کنید:
# SECURE_SSL_REDIRECT=true
# SESSION_COOKIE_SECURE=true
# CSRF_COOKIE_SECURE=true
# SECURE_HSTS_SECONDS=2592000

# --- ایمیل (اختیاری) ---
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true
# DEFAULT_FROM_EMAIL=blog@example.com

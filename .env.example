# ---------------------------------------------------------------------------
# نمونه‌ی متغیرهای محیطی. برای توسعه‌ی محلی این فایل را به .env کپی کنید.
# در پروداکشن، dokploy این مقادیر را تزریق می‌کند.
# ---------------------------------------------------------------------------

# --- الزامی در پروداکشن ---
SECRET_KEY=یک-کلید-تصادفی-بلند-اینجا-بگذارید
ALLOWED_HOSTS=blog.example.com
WAGTAILADMIN_BASE_URL=https://blog.example.com

# --- دیتابیس ---
# در توسعه اگر خالی بماند، از sqlite استفاده می‌شود.
# DATABASE_URL=postgres://user:password@db:5432/noghteblog

# --- برندینگ ---
WAGTAIL_SITE_NAME=بلاگ نقطه

# --- اختیاری ---
# CSRF_TRUSTED_ORIGINS=https://blog.example.com
# WAGTAIL_ADMIN_URL=admin          # مسیر پنل مدیریت
# BLOG_API_ENABLED=true            # API فقط-خواندنی
# WAGTAIL_ALLOW_UNICODE_SLUGS=true # اسلاگ فارسی
# LANGUAGE_CODE=fa
# TIME_ZONE=Asia/Tehran
# MEDIA_ROOT=/app/media
# LOG_LEVEL=INFO

# --- ایمیل (اختیاری) ---
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true
# DEFAULT_FROM_EMAIL=blog@example.com
